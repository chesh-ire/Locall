<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Local voice capture. Voice, wake-word, ASR, TTS and the LLM are all on-device. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Alarm/timer voice commands fire standard AlarmClock intents at the system clock
         app. This is a normal (auto-granted) permission; screenshot and lock-screen need
         no permission — they ride the accessibility service's global actions. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- Battery advisor (feature 5): reads battery/device state and, after confirmation,
         applies power-saving changes — brightness, adaptive brightness and screen timeout
         are written through Settings.System, which needs the special "Modify system
         settings" grant the user toggles in Settings (Settings.System.canWrite). -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Email feature (feature 4) is the ONE part that talks to the network: the Gmail
         inbox lives on a remote server, so reading/clearing it requires INTERNET and
         Google OAuth. All AI processing (summaries, intent) still runs locally — only
         the mailbox fetch/modify goes online. See voice/email/ and EMAIL_SETUP.md. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Personal agent (unified inbox + tasks + planning): exact-time reminders for tasks and
         deadlines via AlarmManager → ReminderReceiver → a LocaLL notification. USE_EXACT_ALARM is
         the install-granted permission for reminder/alarm apps on Android 13+; SCHEDULE_EXACT_ALARM
         covers 12. WhatsApp/SMS capture rides a user-enabled NotificationListenerService (no extra
         manifest permission — the special access is toggled in Settings ▸ Notification access). -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Package visibility (Android 11+): we're a voice launcher, so we must be able
         to see every launchable app in order to open it by spoken name. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Required on Android 11+ to discover/bind the system speech recognizer. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- Spotify voice control: we open spotify: deep links (ACTION_VIEW) and need
             to see the installed Spotify app on Android 11+. No network/API is used. -->
        <package android:name="com.spotify.music" />
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LocaLL">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.LocaLL"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Always-on listening. microphone type is required for background mic (Android 10+). -->
        <service
            android:name=".voice.WakeWordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- The "full control" layer: types into other apps, launches apps, navigates.
             The user must enable this in Settings > Accessibility. -->
        <service
            android:name=".voice.VoiceAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Passive capture of messaging notifications (WhatsApp/SMS/Messenger/Telegram) into the
             agent's unified inbox. Reads only the title + text line; no history, media or uploads.
             User-enabled in Settings ▸ Notification access. -->
        <service
            android:name=".voice.agent.inbox.NotificationCaptureService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Fires task/deadline reminders scheduled by FollowUpManager via AlarmManager. -->
        <receiver
            android:name=".voice.agent.follow.ReminderReceiver"
            android:exported="false" />
    </application>

</manifest>